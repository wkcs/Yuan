/// @spec_ref: 4.8
/// @point_id: 4_8_item
/// @case_id: 4_8_item__core_pass
/// @expect: pass
/// @boundary: core
/// @phase: sema
/// @diag_codes:
/// @diag_keywords:
// match 表达式：模式匹配、通配符
enum Color {
    Red,
    Green,
    Blue,
}

func main() -> i32 {
    var color: Color = Color.Green
    var value: i32 = match color {
        Color.Red => 1,
        Color.Green => 2,
        Color.Blue => 3,
    }
    var __spec2026_actual: i32 = value
    var __spec2026_expected: i32 = 2
    @assert(__spec2026_actual == __spec2026_expected, "4_8_item assertion failed")
    return __spec2026_actual
}
