// Copy 判定：基本标量类型为 Copy
func main() -> i32 {
    var x: i32 = 42
    var y: i32 = x      // Copy: x 仍可用
    var z: i32 = x      // x 仍可用
    var __spec2026_actual: i32 = x + y + z
    var __spec2026_expected: i32 = 126
    @assert(__spec2026_actual == __spec2026_expected, "18_2_copy assertion failed")
    return __spec2026_actual
}
