/// \file env.yu
/// \brief 进程环境与命令行参数模块

pub struct Args {
    count: usize,
}

impl Args {
    pub func len(&self) -> usize {
        return self.count
    }

    pub func at(&self, index: usize) -> str {
        if index >= self.count {
            @panic("env.args index out of bounds")
        }
        return @os_arg_at(index)
    }
}

pub func args() -> Args {
    return Args { count: @os_args_len() }
}

pub func get(name: str) -> ?str {
    if @os_env_has(name) {
        var value: str = @os_env_get(name)
        return value
    }
    return None
}
